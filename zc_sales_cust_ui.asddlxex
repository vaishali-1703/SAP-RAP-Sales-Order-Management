@Metadata.layer: #CORE

annotate entity ZC_SALES_CUST with
{
    @UI.facet: [
        {
            id: 'GeneralInfo',
            purpose: #STANDARD,
            type: #IDENTIFICATION_REFERENCE,
            label: 'Customer Information',
            position: 10
        }
    ]

    @UI.lineItem: [{ position: 10 }]
    @UI.identification: [{ position: 10, label: 'Customer ID' }]
    CustomerID;

    @UI.lineItem: [{ position: 20 }]
    @UI.identification: [{ position: 20, label: 'First Name' }]
    FirstName;

    @UI.lineItem: [{ position: 30 }]
    @UI.identification: [{ position: 30, label: 'Last Name' }]
    LastName;

    @UI.lineItem: [{ position: 40 }]
    @UI.identification: [{ position: 40, label: 'Email' }]
    Email;

    @UI.lineItem: [{ position: 50 }]
    @UI.identification: [{ position: 50, label: 'Phone' }]
    Phone;

    @UI.lineItem: [{ position: 60 }]
    @UI.identification: [{ position: 60, label: 'City' }]
    City;
}