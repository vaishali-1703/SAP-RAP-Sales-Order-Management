@Metadata.layer: #CORE

annotate entity ZC_SALES_ITEM
    with
{
    @UI.lineItem: [{ position: 10, label: 'Item Number' }]
    ItemNumber;

    @UI.lineItem: [{ position: 20, label: 'Product Name' }]
    ProductName;

    @UI.lineItem: [{ position: 30, label: 'Quantity' }]
    Quantity;

    @UI.lineItem: [{ position: 40, label: 'Unit Price' }]
    UnitPrice;

    @UI.lineItem: [{ position: 50, label: 'Item Amount' }]
    ItemAmount;
}