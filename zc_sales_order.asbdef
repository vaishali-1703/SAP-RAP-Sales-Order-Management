projection;
strict ( 2 );
use draft;

define behavior for ZC_SALES_ORDER
{
    use create;
    use update;
    use delete;

    use action Edit;
    use action Activate;
    use action Discard;
    use action Resume;
    use action Prepare;

    use association _Items { create; }
}

define behavior for ZC_SALES_ITEM
{
    use update;
    use delete;

    use association _SalesOrder;
}