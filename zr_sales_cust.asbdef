managed implementation in class zbp_r_sales_cust unique;
strict ( 2 );
with draft;

define behavior for ZR_SALES_CUST
persistent table ztcust
draft table ztcust_d
lock master
total etag LastChangedAt
authorization master ( global )
{
    create;
    update;
    delete;

   field ( readonly : update ) CustomerID;
field ( readonly ) LastChangedAt;

    draft action Edit;
    draft action Activate;
    draft action Discard;
    draft action Resume;

    draft determine action Prepare;

    mapping for ztcust
    {
        CustomerID    = customer_id;
        FirstName     = first_name;
        LastName      = last_name;
        Email         = email;
        Phone         = phone;
        City          = city;
        LastChangedAt = last_changed_at;
    }

}