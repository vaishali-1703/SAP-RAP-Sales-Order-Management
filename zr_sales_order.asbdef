managed implementation in class zbp_r_sales_order unique;
strict ( 2 );
with draft;

define behavior for ZR_SALES_ORDER
persistent table ztsoh
draft table ztsoh_d
lock master
total etag LastChangedAt
authorization master ( global )
{
    create;
    update;
    delete;



    field ( readonly : update ) SalesOrder;
    field ( readonly ) LastChangedAt;

    draft action Edit;
    draft action Activate;
    draft action Discard;
    draft action Resume;
    draft determine action Prepare;

    association _Items { create; with draft; }

    mapping for ztsoh
    {
        SalesOrder     = sales_order;
        CustomerID     = customer_id;
        OrderDate      = order_date;
        TotalAmount    = total_amount;
        CurrencyCode   = currency_code;
        OrderStatus    = order_status;
        LastChangedAt  = last_changed_at;
    }
}

define behavior for ZR_SALES_ITEM alias Item
persistent table ztsoi
draft table ztsoi_d
lock dependent by _SalesOrder
authorization dependent by _SalesOrder
{
    update;
    delete;

   determination CalculateItemAmount on modify
    {
        field Quantity, UnitPrice;
    }

    field ( readonly ) SalesOrder;
    field ( readonly : update ) ItemNumber;

    association _SalesOrder;

    mapping for ztsoi
    {
        SalesOrder  = sales_order;
        ItemNumber  = item_number;
        ProductName = product_name;
        Quantity    = quantity;
        UnitPrice   = unit_price;
        ItemAmount  = item_amount;
    }
}